# Site
NEXT_PUBLIC_SITE_URL=https://www.criaremoema.com.br

# Firebase Auth (console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Service account JSON)
# Na Vercel: uma linha com \n (sem aspas extras no painel).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Sessão HMAC do Studio (mínimo 16 caracteres, aleatória)
STUDIO_SESSION_SECRET=

# E-mails com acesso ao /studio (separados por vírgula)
STUDIO_ALLOWED_EMAILS=

# Cloudinary (cloud name aparece em Dashboard → API Keys, ex.: e8njndza)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: substitui o trio acima
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
